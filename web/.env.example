# 服务监听
STOCK_PORT=8789
STOCK_HOST=127.0.0.1

# 数据目录（自选股 / AI 配置 / 密钥都落这里；容器内为 /data 命名卷）
STOCK_DATA_DIR=./data

# 与博客**同一个** SESSION_SECRET —— 支持博客 zx_admin cookie 单点登录（站长身份）。
# 不配的后果：顶栏的 ⚙（AI 设置）整块不渲染，AI 面板也进不去，只能靠下面的
# STOCK_OWNER_TOKEN 兜底。本地开发直接照抄 zxLumen-Blog/apps/next-home/.env.local 那一行。
# SESSION_SECRET=

# 访客是否可用 AI 解读（默认 1；设 0 则只有站长能用）
# STOCK_VISITOR_AI=1

# 博客站点地址（用于 AI 状态灯 / 预留）
# BLOG_ORIGIN=https://example.com

# 站长兜底 token（未配 SESSION_SECRET 时可用 /?owner=<token> 进站长模式）
# 取值见数据目录 owner.token；也可显式指定覆盖
# STOCK_OWNER_TOKEN=

# 大模型经博客 AI 网关(令牌在博客 admin「AI 密钥」页生成后填这里)。
# 不填 ZX_AI_GATEWAY_URL 时默认 http://localhost:3000/api/ai/v1(本地);
# 线上容器内由 docker-compose 注入 http://app:3000/api/ai/v1。
ZX_AI_GATEWAY_URL=
ZX_AI_APP_TOKEN=